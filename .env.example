# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# BOOSTERA Frontend Variables (Safe for Browser — Trigger/Read Scope Only)
# ==============================================================================
BOOSTERA_API_URL="/api/v1"
BOOSTERA_CLIENT_KEY=""
BOOSTERA_WS_URL=""

# ==============================================================================
# BOOSTERA Backend-Only Secrets (NEVER exposed to Browser)
# ==============================================================================
BOOSTERA_UPSTREAM_URL="https://share-dragon-apparel-increased.trycloudflare.com"
BOOSTERA_ADMIN_KEY=""
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
DEEPAR_CONFIG=""

# Temporary Legacy Compatibility Adapter (Backend Only — Never exposed to Frontend)
ARIEL_SERVER_URL="https://share-dragon-apparel-increased.trycloudflare.com"
ARIEL_ADMIN_KEY=""
ARIEL_CLIENT_KEY=""
